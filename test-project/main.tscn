[sub_resource type="GDScript" id="Script_1"]
script/source = "extends Node3D

var _beep_player: AudioStreamPlayer
var _beep_playback: AudioStreamGeneratorPlayback
var _beep_interval := 1.2
var _beep_freq := 880.0
var _beep_duration := 0.15
var _sample_rate := 44100.0
var _xr_ok := false
var _frame_count := 0
var _log_timer := 0.0

func _ready():
	var interface = XRServer.find_interface(\"visionOS\")
	if interface and interface.initialize():
		print(\"[Pilot] visionOS XR initialized OK\")
		_xr_ok = true
		var viewport = get_viewport()
		viewport.use_xr = true
		viewport.vrs_mode = Viewport.VRS_XR
	else:
		print(\"[Pilot] visionOS XR init FAILED\")
	_write_log(\"XR init: \" + (\"OK\" if _xr_ok else \"FAILED\"))
	_setup_beep()
	_queue_beep()

func _process(delta: float):
	_frame_count += 1
	_log_timer += delta
	if _log_timer >= 5.0:
		_log_timer = 0.0
		_append_log(\"frames=%d xr_ok=%s\" % [_frame_count, str(_xr_ok)])

func _write_log(msg: String):
	var f = FileAccess.open(\"user://xr_diag.txt\", FileAccess.WRITE)
	if f:
		f.store_string(msg + \"\\n\")
		f.close()
		print(\"[Pilot] \" + msg)

func _append_log(msg: String):
	var f = FileAccess.open(\"user://xr_diag.txt\", FileAccess.READ_WRITE)
	if f == null:
		f = FileAccess.open(\"user://xr_diag.txt\", FileAccess.WRITE)
	if f:
		f.seek_end(0)
		f.store_string(msg + \"\\n\")
		f.close()
		print(\"[Pilot] \" + msg)

func _setup_beep():
	var gen = AudioStreamGenerator.new()
	gen.mix_rate = _sample_rate
	gen.buffer_length = 0.5
	_beep_player = AudioStreamPlayer.new()
	_beep_player.stream = gen
	_beep_player.volume_db = 0.0
	add_child(_beep_player)
	_beep_player.play()
	_beep_playback = _beep_player.get_stream_playback()

func _queue_beep():
	await get_tree().create_timer(_beep_interval).timeout
	_push_beep(_beep_freq, _beep_duration)
	_queue_beep()

func _push_beep(freq: float, duration: float):
	if _beep_playback == null:
		return
	var num_samples = int(_sample_rate * duration)
	for i in range(num_samples):
		var t = float(i) / _sample_rate
		var env = sin(PI * t / duration)
		var sample = sin(TAU * freq * t) * env * 0.6
		_beep_playback.push_frame(Vector2(sample, sample))
"

