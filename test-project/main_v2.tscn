[node name="PassthroughDepthFix" type="MeshInstance3D" parent="XROrigin3D/XRCamera3D"]
; Full-screen depth-bias quad — kills the mixed-immersion blocky alpha halo by
; ensuring depth is never exactly 0 where the compositor blends over passthrough.
; See passthrough_depth_fix.gdshader. extra_cull_margin keeps it from being
; frustum-culled (the shader writes clip-space POSITION directly, so the quad's
; transform/AABB is meaningless for rendering but still used for culling).
extra_cull_margin = 16384.0
mesh = SubResource("QuadMesh_depthfix")

